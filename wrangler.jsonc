// Cloudflare Workers: the landing site built by `bash site/build.sh dist`, plus a small Worker for /api/* only
// (the online estimate, the friends and squads of the app: worker/index.js, worker/friends.js). _headers and _redirects in site/ are copied into dist/ and applied by Cloudflare.
// Secret to add in the dashboard (Settings → Variables and secrets): FORTNITE_API_KEY = a fortnite-api.com key.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fortnite-chest-tracker",
  "compatibility_date": "2026-11-01",
  "main": "worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // only the API runs code; every page and file is served straight from the assets
    "run_worker_first": ["/api/*"],
    // /fr -> /fr/, /index.html -> /
    "html_handling": "auto-trailing-slash",
    // unknown paths get 404.html with a real 404 status
    "not_found_handling": "404-page"
  },
  "observability": { "enabled": false },
  // Friends and squads of the app (worker/friends.js): one Durable Object with its own SQLite database, created on deploy.
  "durable_objects": { "bindings": [{ "name": "HUB", "class_name": "FriendsHub" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["FriendsHub"] }]
}
